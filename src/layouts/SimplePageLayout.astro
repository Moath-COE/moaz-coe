---
import type { Lang } from '@types';
import BaseLayout from './BaseLayout.astro';
import Ornament from '@components/Ornament.astro';

interface Props {
	title: string;
	description: string;
	pageTitle: string;
	locale: Lang;
}
const { title, description, pageTitle, locale } = Astro.props;
---

<BaseLayout title={title} description={description} pageTitle={pageTitle} locale={locale}>
	<article class="page layout">
		<header class="page-head">
			<h1>{pageTitle}</h1>
		</header>
		<div class="margin">{Astro.slots.has('margin') ? <slot name="margin" /> : <Ornament />}</div>
		<div class="prose"><slot /></div>
	</article>
</BaseLayout>
