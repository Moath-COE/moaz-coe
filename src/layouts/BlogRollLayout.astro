---
import type { Lang } from '@types';
import BaseLayout from './BaseLayout.astro';
import { site } from '@i18n/sections';

interface Props { locale: Lang; section: string }
const { locale, section } = Astro.props;
---

<BaseLayout title={site.title[locale]} description={site.description[locale]} pageTitle={section} locale={locale}>
	<slot />
</BaseLayout>
