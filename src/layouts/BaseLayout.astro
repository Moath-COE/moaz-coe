---
import type { Lang } from '@types';
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
	title: string;
	description: string;
	pageTitle?: string;
	locale: Lang;
	heroImage?: string;
}
const { title, description, pageTitle, locale, heroImage } = Astro.props;
---

<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
	<head><BaseHead title={title} description={description} pageTitle={pageTitle} locale={locale} heroImage={heroImage} /></head>
	<body>
		<Header locale={locale} />
		<main id="content"><slot /></main>
		<Footer locale={locale} />
	</body>
</html>
