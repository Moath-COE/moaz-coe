---
import type { Lang } from '@types';
import { labels } from '@i18n/ui';

interface Props { prevUrl?: string; nextUrl?: string; locale: Lang }
const { prevUrl, nextUrl, locale } = Astro.props;
---

{(prevUrl || nextUrl) && (
	<nav class="pagination" aria-label={locale === 'ar' ? 'صفحات المقالات' : 'Post pages'}>
		{prevUrl ? <a rel="prev" href={prevUrl}><span class="arrow back" aria-hidden="true">→</span> {labels[locale].newer}</a> : <span />}
		{nextUrl && <a rel="next" href={nextUrl}>{labels[locale].older} <span class="arrow" aria-hidden="true">→</span></a>}
	</nav>
)}
