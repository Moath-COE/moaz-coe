---
import type { Lang } from '@types';
import MainNavLangs from './MainNavLangs.astro';
import HeaderLink from './HeaderLink.astro';
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '@i18n/sections';
import { labels } from '@i18n/ui';
import { localize } from '@i18n/utils';

interface Props { locale: Lang }
const { locale } = Astro.props;
---

<a class="skip-link" href="#content">{labels[locale].skip}</a>
<header class="site-header">
	<nav class="site-nav" aria-label={locale === 'ar' ? 'التنقل الرئيسي' : 'Main navigation'}>
		<a class="brand" href={localize(locale)} aria-label={labels[locale].home}>
			<Mark />
			<span>{site.title[locale]}</span>
		</a>
		<div class="nav-links">
			<HeaderLink href={localize(locale, 'blog')}>{labels[locale].blog}</HeaderLink>
			<HeaderLink href={localize(locale, 'about')}>{labels[locale].about}</HeaderLink>
		</div>
		<div class="nav-tools">
			<MainNavLangs locale={locale} />
			<ThemeToggle label={labels[locale].theme} />
		</div>
	</nav>
</header>
