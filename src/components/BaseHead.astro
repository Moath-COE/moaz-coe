---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/reem-kufi';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/ibm-plex-sans/wght-italic.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { Lang } from '@types';
import { ogStrings } from '@i18n/ui';
import { counterpartUrl, localize, publicAsset } from '@i18n/utils';
import { site } from '@i18n/sections';
import { publishedPosts } from '@lib/blog';

interface Props {
	title: string;
	description: string;
	pageTitle?: string;
	heroImage?: ImageMetadata;
	locale: Lang;
}

const { title, description, pageTitle, heroImage, locale } = Astro.props;
const fullTitle = pageTitle && pageTitle !== title ? `${pageTitle} · ${title}` : title;
const canonicalURL = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site);
// Social previews get a 1200px JPEG of the hero image, which every platform accepts.
const ogImage = heroImage && (await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src;
const imageURL = new URL(ogImage ?? publicAsset(site.photo), Astro.site);
// hreflang links tell search engines about the translation, only when this page has an exact one.
const other: Lang = locale === 'ar' ? 'en' : 'ar';
const otherURL = counterpartUrl(Astro.url.pathname, locale, other, await publishedPosts());
const alternates = otherURL && ({ [locale]: canonicalURL, [other]: new URL(otherURL, Astro.site) } as Record<Lang, URL>);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<script is:inline>
	(() => {
		let theme;
		try { theme = localStorage.getItem('theme'); } catch {}
		if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		document.documentElement.dataset.theme = theme;
	})();
</script>
<link rel="icon" type="image/svg+xml" href={publicAsset('/favicon.svg')} />
<link rel="canonical" href={canonicalURL} />
{alternates && (
	<>
		<link rel="alternate" hreflang="ar" href={alternates.ar} />
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="x-default" href={alternates.ar} />
	</>
)}
<link rel="alternate" type="application/rss+xml" title={`${title} RSS`} href={localize(locale, 'rss.xml')} />
<link rel="sitemap" href={publicAsset('/sitemap-index.xml')} />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogStrings[locale]} />
<meta property="og:image" content={imageURL} />
<meta name="twitter:card" content={heroImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:image" content={imageURL} />
