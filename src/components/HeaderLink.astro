---
import type { HTMLAttributes } from 'astro/types';
import { localize } from '@i18n/utils';

type Props = HTMLAttributes<'a'>;
const { href, ...props } = Astro.props;
const current = Astro.url.pathname;
const url = typeof href === 'string' ? href : href?.toString() ?? '';
const isActive = url === current || (url !== localize('ar') && url !== localize('en') && current.startsWith(url));
---

<a href={href} aria-current={isActive ? 'page' : undefined} {...props}><slot /></a>
