---
import type { Lang } from '@types';
import { localize } from '@i18n/utils';

interface Props { tags: string[]; locale: Lang; current?: string }
const { tags, locale, current } = Astro.props;
---

{tags.length > 0 && (
	<nav class="tags" aria-label={locale === 'ar' ? 'التصنيفات' : 'Topics'}>
		<ul>
			{tags.map((tag) => (
				<li><a href={localize(locale, `tags/${encodeURIComponent(tag)}`)} aria-current={tag === current ? 'page' : undefined}>{tag}</a></li>
			))}
		</ul>
	</nav>
)}
