---
import type { Lang } from '@types';
import { publishedPosts } from '@lib/blog';
import { languages } from '@i18n/ui';
import { alternateUrl } from '@i18n/utils';

interface Props { locale: Lang }
const { locale } = Astro.props;
const posts = await publishedPosts();
const other: Lang = locale === 'ar' ? 'en' : 'ar';
---

<a class="language-switch" href={alternateUrl(Astro.url.pathname, locale, other, posts)} hreflang={other} lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'}>{languages[other]}</a>

<script>
	// Remember an explicit choice so the home page stops redirecting by browser language (see functions/index.js).
	document.querySelectorAll<HTMLAnchorElement>('.language-switch').forEach((link) => {
		link.addEventListener('click', () => {
			document.cookie = `lang=${link.hreflang}; path=/; max-age=31536000; samesite=lax`;
		});
	});
</script>
