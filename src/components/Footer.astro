---
import type { Lang } from '@types';
import Ornament from './Ornament.astro';
import SocialLinks from './SocialLinks.astro';
import { site } from '@i18n/sections';
import { labels } from '@i18n/ui';
import { localize } from '@i18n/utils';

interface Props { locale: Lang }
const { locale } = Astro.props;
const year = new Intl.NumberFormat(locale, { useGrouping: false }).format(new Date().getFullYear());
---

<footer class="site-footer">
	<p>© {year} {site.author[locale]}</p>
	<Ornament />
	<div class="footer-links">
		<SocialLinks variant="icons" label={labels[locale].social} />
		{site.contact[locale] && <a href={`mailto:${site.contact[locale]}`}>{site.contact[locale]}</a>}
		<a href={localize(locale, 'rss.xml')}>{labels[locale].rss}</a>
	</div>
</footer>
