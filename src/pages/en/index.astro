---
import BaseLayout from '@layouts/BaseLayout.astro';
import Portrait from '@components/Portrait.astro';
import FocusAreas from '@components/FocusAreas.astro';
import GitHubActivity from '@components/GitHubActivity.astro';
import RecentPosts from '@components/RecentPosts.astro';
import SocialLinks from '@components/SocialLinks.astro';
import { labels } from '@i18n/ui';
import { site } from '@i18n/sections';
const locale = 'en';
---

<BaseLayout title={site.title[locale]} description={site.description[locale]} locale={locale}>
	<section class="hero layout">
		<Portrait class="margin" locale={locale} showName={false} />
		<div class="hero-text">
			<h1>Hi, I’m {site.author[locale]}.</h1>
			<p class="lead">{site.description[locale]}</p>
			<p>{site.expand[locale]}</p>
			<SocialLinks label={labels[locale].social} />
		</div>
	</section>
	<FocusAreas locale={locale} />
	<GitHubActivity locale={locale} />
	<RecentPosts locale={locale} />
</BaseLayout>
