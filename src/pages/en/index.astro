---
// IMPORTS
import type { Multi } from "@types";
import SimplePageLayout from "@layouts/SimplePageLayout.astro";
import { site } from "@i18n/sections";
import { defaultLang } from "@i18n/ui";

// ACTIONS
const locale: keyof Multi = Astro.currentLocale || defaultLang;
---

<SimplePageLayout
  title={site.title[locale]}
  description={site.description[locale]}
  pageTitle="🧑‍🚀 Hello, multilingual Astronaut!"
  locale={locale}
>
  <p>
    <strong>AstroLingo</strong> is a minimalistic Astro blog template with robust
    multilingual (i18n) support. It packs all (or at least much of) the functionality
    needed for a multilingual personal, blog, or portfolio website, and leaves you
    room to easily adjust the design to match your brand and taste.
  </p>

  <p>New languages are easy to add.</p>

  <h2>Features</h2>
  <strong>General features:</strong>
  <ul>
    <li>✅ Minimal styling (make it your own!)</li>
    <li>✅ Top Lighthouse performance</li>
    <li>✅ SEO-friendly with canonical URLs and OpenGraph data</li>
    <li>✅ Sitemap support</li>
    <li>✅ RSS Feed support</li>
    <li>✅ Markdown & MDX support.</li>
  </ul>

  <strong>Multilingual (i18n) features:</strong>
  <ul>
    <li>✅ Multilingual pages</li>
    <li>✅ Multilingual blogs</li>
    <li>✅ Multilingual tags</li>
    <li>✅ Multilingual paths</li>
    <li>✅ Multilingual pagination (blogs and tags)</li>
    <li>
      ✅ Independently customisable pages (pages in different languages can be
      different).
    </li>
  </ul>
  <p>Have fun!</p>
  <p>---</p>
  <p>
    Ps1. Detailed guidance available via <a
      href="https://github.com/jbolns/astrolingo"
      target="_blank">GitHub</a
    >.
  </p>
  <p>
    Ps2. Demo available <a
      href="https://astrolingo.josebolanos.xyz/"
      target="_blank">here</a
    >.
  </p>
  <p>
    Ps3. Check <a href="https://www.josebolanos.xyz/" target="_blank"
      >my website</a
    > for a real world implementation that expands on AstroLingo.
  </p>
</SimplePageLayout>
