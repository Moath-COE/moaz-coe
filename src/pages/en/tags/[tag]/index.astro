---
import BlogListing from '@components/BlogListing.astro';
import { publishedPosts, tagsFor } from '@lib/blog';

export async function getStaticPaths() {
	const posts = await publishedPosts('en');
	return tagsFor(posts).map((tag) => ({ params: { tag }, props: { posts, tag } }));
}

const { posts, tag } = Astro.props;
---

<BlogListing locale="en" posts={posts.filter((post) => post.data.tags.includes(tag))} allPosts={posts} tag={tag} />
