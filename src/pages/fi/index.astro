---
// IMPORTS
import type { Multi } from "@types";
import SimplePageLayout from "@layouts/SimplePageLayout.astro";
import { site } from "@i18n/sections";
import { defaultLang } from "@i18n/ui";

// ACTIONS
const locale: keyof Multi = Astro.currentLocale || defaultLang;
---

<SimplePageLayout
  title={site.title[locale]}
  description={site.description[locale]}
  pageTitle="🧑‍🚀 Moi, monikielinen Astronautti!"
  locale={locale}
>
  <p>
    <strong>AstroLingo</strong> on minimalistinen Astro-blogimalli, jossa on vankka
    monikielinen (i18n) tuki. Se sisältää kaikki (tai ainakin suuren osan) toiminnallisuudesta,
    jota tarvitaan monikieliseen henkilökohtaiseen verkkosivustoon, blogiin tai portfolioon,
    ja antaa sinulle tilaa helposti mukauttaa ulkoasua brändisi ja makusi mukaan.
  </p>

  <p>Uusien kielten lisääminen on helppoa.</p>

  <h2>Ominaisuudet</h2>
  <strong>Yleiset ominaisuudet:</strong>
  <ul>
    <li>✅ Minimaalinen muotoilu (tee siitä omasi!)</li>
    <li>✅ Erinomainen Lighthouse suorituskyky</li>
    <li>
      ✅ SEO-ystävällinen kanonisten URL-osoitteiden ja OpenGraph-tietojen
      ansiosta
    </li>
    <li>✅ Sivustokartan tuki</li>
    <li>✅ RSS-tuki</li>
    <li>✅ Markdown & MDX-tuki.</li>
  </ul>

  <strong>Monikieliset (i18n) ominaisuudet:</strong>
  <ul>
    <li>✅ Monikieliset sivut</li>
    <li>✅ Monikieliset blogit</li>
    <li>✅ Monikieliset tunnisteet</li>
    <li>✅ Monikieliset URL-osoitteet</li>
    <li>✅ Monikielinen sivutus (blogit ja tagit)</li>
    <li>
      ✅ Itsenäisesti muokattavissa olevat sivut (erikielisillä sivuilla voi
      olla omat tyylinsä).
    </li>
  </ul>
  <p>Pidä hauskaa!</p>
  <p>---</p>
  <p>
    Ps. Tarkemmat ohjeet saatavilla <a
      href="https://github.com/jbolns/astrolingo"
      target="_blank">GitHubissa</a
    >.
  </p>
  <p>
    Pps. <a href="https://www.josebolanos.xyz/" target="_blank">Klikkaa tästä</a
    > demoon.
  </p>
  <p>
    Ppps. Katso <a href="https://www.josebolanos.xyz/" target="_blank"
      >kotisivuiltani</a
    > esimerkki siitä, mitä voit tehdä AstroLingolla.
  </p>
</SimplePageLayout>
