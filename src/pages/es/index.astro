---
// IMPORTS
import type { Multi } from "@types";
import SimplePageLayout from "@layouts/SimplePageLayout.astro";
import { site } from "@i18n/sections";
import { defaultLang } from "@i18n/ui";

// ACTIONS
const locale: keyof Multi = Astro.currentLocale || defaultLang;
---

<SimplePageLayout
  title={site.title[locale]}
  description={site.description[locale]}
  pageTitle="🧑‍🚀 Hola, Astronauta multilingüe!"
  locale={locale}
>
  <p>
    <strong>AstroLingo</strong> es una plantilla/tema para sitios <a
      href="https://astro.build/">Astro</a
    >con soporte para multiples idiomas. Incluye todas (o al menos gran parte)
    de las funciones necesarias para un sitio web personal, blog, o portafolio
    multilingüe, y permite ajustar fácilmente el diseño a tu marca y gustos.
  </p>

  <p>Es posible gregar idiomas fácilmente a lo largo del tiempo.</p>

  <h2>Características</h2>
  <strong>Generales:</strong>
  <ul>
    <li>✅ Estilos mínimos (hazlo tuyo/a!)</li>
    <li>✅ Alta calificación de Lighthouse</li>
    <li>✅ Optimizado para SEO con URL canónicas y datos OpenGraph</li>
    <li>✅ Soporte para mapas del sitio</li>
    <li>✅ Soporte para feeds RSS</li>
    <li>✅ Soporte para Markdown & MDX.</li>
  </ul>

  <strong>Capacidades multilingües (i18n):</strong>
  <ul>
    <li>✅ Página en multiples idiomas</li>
    <li>✅ Blogs en multiples idiomas</li>
    <li>✅ Tags en multiples idiomas</li>
    <li>✅ URLs en multiples idiomas</li>
    <li>✅ Paginación multilingüe (para ambos, blogs y tags)</li>
    <li>
      ✅ Páginas personalizables de forma independiente (las páginas en
      diferentes idiomas pueden ser diferentes).
    </li>
  </ul>
  <p>¡Diviértete!</p>
  <p>---</p>
  <p>
    PD. Para documentación más detallada, leéte este <a
      href="https://github.com/jbolns/astrolingo"
      target="_blank">repositorio GitHub</a
    >.
  </p>
  <p>
    PPD. Da <a href="https://www.josebolanos.xyz/" target="_blank">click aquí</a
    > para un demo.
  </p>
  <p>
    PPPD. Visita <a href="https://www.josebolanos.xyz/" target="_blank"
      >mi sitio</a
    > para un ejemplo de como se puede expandir AstroLingo para uso real.
  </p>
</SimplePageLayout>
